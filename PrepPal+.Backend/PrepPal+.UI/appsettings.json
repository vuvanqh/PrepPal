{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=(localdb)\\ProjectModels;Initial Catalog=PrepPal+;Integrated Security=True;Connect Timeout=30;Encrypt=True;Trust Server Certificate=False;Application Intent=ReadWrite;Multi Subnet Failover=False;Command Timeout=30"
  },
  "Serilog": {
    "Using": [ //sinks
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [ //sink configurations
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt", //+/logs/log[time-stamp].txt
          "rollingInterval": "Month", //create a new file every month [will not override the prev file]
          "fileSizeLimitBytes": "1048576",
          "rollOnFileSizeLimit": true
        }
      }
    ]
  },
  "AllowedOrigins": [
    "https://localhost:5173"
  ],
  "Jwt": {
    "Issuer": "https://localhost:7101",
    "Audience": "https://localhost:5173",
    "expiration_minutes": 5
  },
  "RefreshToken": {
    "expiration_minutes": 60,
    "max_session_lifetime_days": 30
  },
  "RecipeURL": {
    "Default": "https://www.themealdb.com/api/json/v1/1/"
  },
  "RecommendationService": {
    "BaseUrl": "http://127.0.0.1:8000/recommend"
  }
}
